#!/usr/bin/env bash
# sshto - SSH connection menu with configurable groups.
set -euo pipefail

# Handle only these exact invocations locally; forward all other arguments to ssh.
if [[ $# -eq 1 && $1 == --version ]]; then
    printf 'sshto 0.1.0\n'
    exit 0
fi
if [[ $# -eq 1 && $1 == --help ]]; then
    printf '%s\n' 'Usage: sshto [SSH arguments...]' \
        'Without arguments: open the menu using ~/.ssh/config.' \
        'Groups: ${XDG_CONFIG_HOME:-~/.config}/sshto/config; override with SSHTO_CONFIG.' \
        'Controls: 0 All, 1-9 groups, Tab/arrows to navigate, Enter/double-click to connect, q to quit.'
    exit 0
fi
if [[ $# -ge 1 ]]; then
    exec ssh "$@"
fi

SSH_CONFIG="${HOME}/.ssh/config"
if [[ ! -r "$SSH_CONFIG" ]]; then
    printf 'Cannot read %s\n' "$SSH_CONFIG" >&2
    exit 1
fi
if [[ ! -t 0 || ! -t 1 ]]; then
    printf 'The menu requires a terminal; use sshto <Host> for a direct connection.\n' >&2
    exit 1
fi

# Parse configuration as data; never source or eval it.
CONFIG_FILE=${SSHTO_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/sshto/config}
labels=()
rule_groups=()
rule_fields=()
rule_patterns=()
exclusions=()
config_error() {
    printf '%s:%d: %s\n' "$CONFIG_FILE" "$line_number" "$1" >&2
    exit 1
}
load_config() {
    local line kind a b c extra i group_index line_number=0
    if [[ ! -e "$CONFIG_FILE" && ! -L "$CONFIG_FILE" && -z ${SSHTO_CONFIG:-} ]]; then return; fi
    if [[ ! -r "$CONFIG_FILE" ]]; then config_error 'Cannot read configuration file'; fi
    while IFS= read -r line || [[ -n $line ]]; do
        line_number=$((line_number + 1))
        line=${line%$'\r'}
        case "$line" in ''|'#'*) continue ;; esac
        if [[ $line == *[[:cntrl:]]* || $line == *'|' ]]; then config_error 'Control characters and trailing separators are not allowed'; fi
        IFS='|' read -r kind a b c extra <<< "$line"
        case "$kind" in
            group)
                if [[ -z $a || -n $b$c$extra || $a == All || $a == Other ]]; then config_error 'Expected group|name (All and Other are reserved)'; fi
                for ((i=0; i<${#labels[@]}; i++)); do
                    if [[ ${labels[$i]} == "$a" ]]; then config_error 'Duplicate group'; fi
                done
                labels+=("$a")
                ;;
            match)
                if [[ -z $a || -z $c || -n $extra ]]; then config_error 'Expected match|group|alias, hostname or either|glob'; fi
                case "$b" in alias|hostname|either) ;; *) config_error 'Match field must be alias, hostname or either' ;; esac
                group_index=-1
                for ((i=0; i<${#labels[@]}; i++)); do
                    if [[ ${labels[$i]} == "$a" ]]; then group_index=$i; break; fi
                done
                if [[ $group_index -lt 0 ]]; then config_error 'Declare a group before referencing it in a match rule'; fi
                rule_groups+=("$group_index")
                rule_fields+=("$b")
                rule_patterns+=("$(printf '%s' "$c" | tr '[:upper:]' '[:lower:]')")
                ;;
            exclude)
                if [[ -z $a || -n $b$c$extra ]]; then config_error 'Expected exclude|Host alias glob'; fi
                exclusions+=("$(printf '%s' "$a" | tr '[:upper:]' '[:lower:]')")
                ;;
            *) config_error 'Unknown directive; expected group, match or exclude' ;;
        esac
    done < "$CONFIG_FILE"
}
load_config
labels+=('Other')
group_count=${#labels[@]}
tab_total=$((group_count + 1))
shortcut_max=$group_count
if [[ $shortcut_max -gt 9 ]]; then shortcut_max=9; fi

# List explicit aliases from the main config; do not expand Include or wildcard patterns.
parse_hosts() {
    awk 'tolower($1) == "host" {
        for (i=2; i<=NF; i++) {
            if ($i ~ /^#/) break
            if ($i !~ /[*?!]/) print $i
        }
    }' "$SSH_CONFIG" | LC_ALL=C sort -u
}

classify_host() {
    local alias_name="$1" hostname="$2" i pattern field
    category=$((group_count - 1))
    for ((i=0; i<${#rule_groups[@]}; i++)); do
        pattern=${rule_patterns[$i]}
        field=${rule_fields[$i]}
        if { [[ $field == alias || $field == either ]] && [[ $alias_name == $pattern ]]; } ||
           { [[ $field == hostname || $field == either ]] && [[ $hostname == $pattern ]]; }; then
            category=${rule_groups[$i]}
            return
        fi
    done
    return 0
}

hosts=()
infos=()
categories=()
counts=()
for ((i=0; i<group_count; i++)); do counts+=(0); done
while IFS= read -r host; do
    lower_host=$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')
    excluded=0
    for ((i=0; i<${#exclusions[@]}; i++)); do
        if [[ $lower_host == ${exclusions[$i]} ]]; then excluded=1; break; fi
    done
    if [[ $excluded -eq 1 ]]; then continue; fi
    if ! info=$(ssh -G -T "$host" | awk '
        /^hostname / {h=$2}
        /^user / {u=$2}
        END {printf "%s@%s", u, h}
    '); then
        printf 'Cannot resolve SSH configuration for %s\n' "$host" >&2
        exit 1
    fi
    classify_host "$lower_host" \
        "$(printf '%s' "${info#*@}" | tr '[:upper:]' '[:lower:]')"
    hosts+=("$host")
    infos+=("$info")
    categories+=("$category")
    counts[$category]=$(( ${counts[$category]} + 1 ))
done < <(parse_hosts)

if [[ ${#hosts[@]} -eq 0 ]]; then
    printf 'No explicit Host entries found in %s\n' "$SSH_CONFIG" >&2
    exit 1
fi

# Measure tab widths in terminal cells, including wide characters; collapse tabs when needed.
tab_texts=()
tab_widths=()
tabs_width=0
for ((i=0; i<tab_total; i++)); do
    if [[ $i -eq 0 ]]; then
        label=All
        count=${#hosts[@]}
    else
        label=${labels[$((i - 1))]}
        count=${counts[$((i - 1))]}
    fi
    printf -v text ' %d:%s(%d) ' "$i" "$label" "$count"
    tab_texts+=("$text")
    cells=$(/usr/bin/perl -MEncode=decode -e '
        for (split //, decode("UTF-8", $ARGV[0])) {
            $n += /\p{East_Asian_Width=Wide}|\p{East_Asian_Width=Fullwidth}/ ? 2 : /\p{Mn}|\p{Me}|\p{Cf}/ ? 0 : 1;
        }
        print $n // 0;
    ' "$text")
    tab_widths+=("$cells")
    tabs_width=$((tabs_width + cells))
done

tab=0
cur=0
offset=0
visible=()
display_rows=()
host_rows=()
mouse_tab_starts=()
mouse_tab_ends=()
last_click_host=-1
last_click_ms=0
mouse_press_y=0
connect_requested=0
resized=0

select_tab() {
    tab="$1"
    last_click_host=-1
    mouse_press_y=0
    cur=0
    offset=0
    visible=()
    display_rows=()
    host_rows=()
    local i group
    for ((group=0; group<group_count; group++)); do
        if [[ $tab -ne 0 && $group -ne $((tab - 1)) ]]; then continue; fi
        if [[ ${counts[$group]} -eq 0 ]]; then continue; fi
        # All shows group headings and indented hosts; negative row values represent headings.
        if [[ $tab -eq 0 ]]; then display_rows+=("$((-group - 1))"); fi
        for ((i=0; i<${#hosts[@]}; i++)); do
            if [[ ${categories[$i]} -eq $group ]]; then
                host_rows+=("${#display_rows[@]}")
                display_rows+=("$i")
                visible+=("$i")
            fi
        done
    done
    total=${#visible[@]}
    row_total=${#display_rows[@]}
}

# Reserve the last column to prevent wrapping; truncate wide text by terminal cells.
print_line() {
    local LC_ALL=C
    if [[ $1 != *[!\ -~]* ]]; then
        printf '%s' "${1:0:width}"
    else
        /usr/bin/perl -MEncode=decode,encode -e '
            for (split //, decode("UTF-8", $ARGV[0])) {
                $n += /\p{East_Asian_Width=Wide}|\p{East_Asian_Width=Fullwidth}/ ? 2 : /\p{Mn}|\p{Me}|\p{Cf}/ ? 0 : 1;
                last if $n > $ARGV[1];
                print encode("UTF-8", $_);
            }
        ' "$1" "$width"
    fi
}

draw_menu() {
    local dimensions rows cols slots header_rows footer_rows i index text marker max_len alias_width info_width selected_row group indent tab_label tab_column tab_width
    dimensions=$(stty size)
    read -r rows cols <<< "$dimensions"
    if [[ $rows -lt 1 ]]; then rows=1; fi
    if [[ $cols -lt 2 ]]; then cols=2; fi
    width=$((cols - 1))
    header_rows=1
    if [[ $rows -eq 1 ]]; then header_rows=0; fi
    footer_rows=0
    if [[ $rows -ge 3 ]]; then footer_rows=1; fi
    if [[ $rows -ge 5 ]]; then header_rows=2; fi
    slots=$((rows - header_rows - footer_rows))
    # Resolve mouse coordinates against the last rendered headers and scroll position.
    mouse_header_rows=$header_rows
    mouse_slots=$slots
    mouse_rows=$rows
    mouse_cols=$cols
    mouse_tab_starts=()
    mouse_tab_ends=()
    selected_row=0
    if [[ $total -gt 0 ]]; then selected_row=${host_rows[$cur]}; fi
    if [[ $selected_row -lt $offset ]]; then
        offset=$selected_row
        if [[ $slots -gt 1 && $offset -gt 0 && ${display_rows[$((offset - 1))]} -lt 0 ]]; then
            offset=$((offset - 1))
        fi
    fi
    if [[ $selected_row -ge $((offset + slots)) ]]; then offset=$((selected_row - slots + 1)); fi
    if [[ $offset -gt $((row_total - slots)) ]]; then offset=$((row_total - slots)); fi
    if [[ $offset -lt 0 ]]; then offset=0; fi

    printf '\033[H\033[J'
    if [[ $header_rows -eq 0 ]]; then
        : # Keep the only row available for hosts in a one-row window.
    elif [[ $width -ge $tabs_width ]]; then
        tab_column=1
        for ((i=0; i<tab_total; i++)); do
            if [[ $i -eq $tab ]]; then printf '\033[1;36m'; else printf '\033[2m'; fi
            text=${tab_texts[$i]}
            tab_width=${tab_widths[$i]}
            mouse_tab_starts+=("$tab_column")
            mouse_tab_ends+=("$((tab_column + tab_width - 1))")
            tab_column=$((tab_column + tab_width))
            printf '%s' "$text"
            printf '\033[0m'
        done
    else
        printf '\033[1;36m'
        tab_label=All
        if [[ $tab -gt 0 ]]; then tab_label=${labels[$((tab - 1))]}; fi
        if [[ $cols -ge 24 ]]; then
            print_line "$tab:$tab_label ($total)"
        else
            print_line "$tab: ($total)"
        fi
        printf '\033[0m'
    fi
    if [[ $header_rows -gt 0 ]]; then printf '\r\n'; fi
    if [[ $header_rows -eq 2 ]]; then
        if [[ $cols -ge 78 ]]; then
            printf -v text '  Left/Right Tab: group  0-%d: jump  Up/Down: select  Enter: connect  q/Esc: quit' "$shortcut_max"
            print_line "$text"
        else
            print_line '< > Tab: group  Up/Down  Enter  q/Esc'
        fi
        printf '\r\n'
    fi

    max_len=0
    for ((i=0; i<total; i++)); do
        index=${visible[$i]}
        if [[ ${#hosts[$index]} -gt $max_len ]]; then max_len=${#hosts[$index]}; fi
    done
    indent=''
    if [[ $tab -eq 0 ]]; then indent='  '; fi
    alias_width=$max_len
    if [[ $alias_width -gt $(( (width - 6 - ${#indent}) / 2 )) ]]; then alias_width=$(( (width - 6 - ${#indent}) / 2 )); fi
    info_width=$((width - alias_width - 6 - ${#indent}))
    if [[ $total -eq 0 ]]; then
        if [[ $cols -ge 24 ]]; then printf '  No hosts in this group'; else print_line '(empty)'; fi
    else
        for ((i=offset; i<row_total && i<offset+slots; i++)); do
            index=${display_rows[$i]}
            if [[ $index -lt 0 ]]; then
                group=$((-index - 1))
                printf '\033[1;36m'
                print_line "${labels[$group]} (${counts[$group]})"
                printf '\033[0m'
                if [[ $i -lt $((offset + slots - 1)) && $i -lt $((row_total - 1)) ]]; then printf '\r\n'; fi
                continue
            fi
            marker=' '
            if [[ $i -eq $selected_row ]]; then
                marker='>'
                printf '\033[1;97;44m'
            fi
            if [[ $cols -ge 78 ]]; then
                printf -v text '%s %s %-*.*s  %.*s' \
                    "$indent" "$marker" \
                    "$alias_width" "$alias_width" "${hosts[$index]}" "$info_width" "${infos[$index]}"
            else
                text="${hosts[$index]}"
                if [[ $width -ge 3 ]]; then text="$indent$marker $text"; fi
            fi
            print_line "$text"
            printf '\033[0m'
            if [[ $i -lt $((offset + slots - 1)) && $i -lt $((row_total - 1)) ]]; then printf '\r\n'; fi
        done
    fi
    if [[ $footer_rows -eq 1 ]]; then
        printf '\033[%d;1H\033[2m' "$rows"
        print_line "sshto  $((total > 0 ? cur + 1 : 0))/$total  Click: select  Double-click: connect  Wheel: move"
        printf '\033[0m'
    fi
    resized=0
}

handle_mouse() {
    local event="$1" pattern='^<([0-9]{1,5});([0-9]{1,5});([0-9]{1,5})([Mm])$'
    local button x y phase i row click_ms host_index
    # Activate on release in the same row; consume the release before handing stdin to SSH.
    if [[ ! $event =~ $pattern ]]; then return 0; fi
    button=$((10#${BASH_REMATCH[1]}))
    x=$((10#${BASH_REMATCH[2]}))
    y=$((10#${BASH_REMATCH[3]}))
    phase=${BASH_REMATCH[4]}
    if [[ $resized -eq 1 ]]; then mouse_press_y=0; return 0; fi
    if [[ $x -lt 1 || $x -ge $mouse_cols || $y -lt 1 || $y -gt $mouse_rows ]]; then return 0; fi
    if [[ $button -eq 0 ]]; then
        if [[ $phase == M ]]; then mouse_press_y=$y; return 0; fi
        if [[ $mouse_press_y -ne $y ]]; then mouse_press_y=0; last_click_host=-1; return 0; fi
        mouse_press_y=0
    elif [[ $phase == m ]]; then
        return 0
    else
        mouse_press_y=0
    fi
    if [[ $button -eq 0 && $y -eq 1 && $mouse_header_rows -gt 0 ]]; then
        for ((i=0; i<${#mouse_tab_starts[@]}; i++)); do
            if [[ $x -ge ${mouse_tab_starts[$i]} && $x -le ${mouse_tab_ends[$i]} ]]; then
                select_tab "$i"
                return 0
            fi
        done
    fi
    if [[ $y -le $mouse_header_rows || $y -gt $((mouse_header_rows + mouse_slots)) ]]; then return 0; fi
    case "$button" in
        0)
            row=$((offset + y - mouse_header_rows - 1))
            for ((i=0; i<total; i++)); do
                if [[ ${host_rows[$i]} -eq $row ]]; then
                    cur=$i
                    host_index=${visible[$i]}
                    # Bash 3.2 has no millisecond clock; use system Perl monotonic time for double-clicks.
                    click_ms=$(/usr/bin/perl -MTime::HiRes=clock_gettime,CLOCK_MONOTONIC \
                        -e 'printf "%.0f", clock_gettime(CLOCK_MONOTONIC)*1000')
                    if [[ $host_index -eq $last_click_host && $((click_ms - last_click_ms)) -le 450 ]]; then
                        connect_requested=1
                    fi
                    last_click_host=$host_index
                    last_click_ms=$click_ms
                    return 0
                fi
            done
            last_click_host=-1
            ;;
        64) last_click_host=-1; if [[ $cur -gt 0 ]]; then cur=$((cur - 1)); fi ;;
        65) last_click_host=-1; if [[ $cur -lt $((total - 1)) ]]; then cur=$((cur + 1)); fi ;;
        *) last_click_host=-1 ;;
    esac
    return 0
}

read_csi() {
    local char sequence='' LC_ALL=C
    # Consume the full CSI sequence so mouse coordinates cannot trigger numeric shortcuts.
    while [[ ${#sequence} -lt 64 ]]; do
        if ! IFS= read -rsn1 -t 1 char; then return 0; fi
        sequence+="$char"
        case "$char" in
            [@-~]) break ;;
        esac
    done
    if [[ "$sequence" != '<'* ]]; then last_click_host=-1; mouse_press_y=0; fi
    case "$sequence" in
        A) if [[ $cur -gt 0 ]]; then cur=$((cur - 1)); fi ;;
        B) if [[ $cur -lt $((total - 1)) ]]; then cur=$((cur + 1)); fi ;;
        C) select_tab "$(((tab + 1) % tab_total))" ;;
        D|Z) select_tab "$(((tab + tab_total - 1) % tab_total))" ;;
        '<'*) handle_mouse "$sequence" ;;
        M)
            # Consume three legacy mouse bytes without treating coordinates as shortcuts.
            IFS= read -rsn3 -t 1 char || true
            ;;
    esac
    return 0
}

connect_selected() {
    local target=${hosts[${visible[$cur]}]}
    cleanup
    trap - EXIT
    printf 'Connecting to %s ...\n' "$target"
    exec ssh "$target"
}

cleanup() {
    printf '\033[?1000l\033[?1006l\033[0m\033[?25h\033[?1049l'
    stty "$terminal_state"
}
terminal_state=$(stty -g)
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
stty -echo
printf '\033[?1049h\033[?25l\033[?1006h\033[?1000h'
select_tab 0
trap 'resized=1' WINCH
draw_menu

while true; do
    # Periodically finish read so Bash 5 can handle WINCH even without keyboard input.
    # Bash 3.2 returns 1 for both timeout and EOF; distinguish them by elapsed time.
    read_started=$SECONDS
    if IFS= read -rsn1 -t 1 key; then
        if [[ "$key" != $'\x1b' ]]; then last_click_host=-1; mouse_press_y=0; fi
        case "$key" in
            $'\x1b')
                if ! IFS= read -rsn1 -t 1 prefix; then exit 0; fi
                if [[ "$prefix" == '[' || "$prefix" == 'O' ]]; then
                    read_csi
                else
                    exit 0
                fi
                ;;
            $'\t') select_tab "$(((tab + 1) % tab_total))" ;;
            [0-9]) if [[ $key -lt $tab_total ]]; then select_tab "$key"; fi ;;
            '')
                if [[ $total -gt 0 ]]; then connect_requested=1; fi
                ;;
            q|Q|$'\x04') exit 0 ;;
        esac
        if [[ $connect_requested -eq 1 ]]; then connect_selected; fi
        draw_menu
    else
        if [[ $resized -eq 1 ]]; then
            draw_menu
        elif [[ $SECONDS -eq $read_started ]]; then
            exit 0
        fi
    fi
done
